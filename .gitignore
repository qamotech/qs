# ==============================================================================
# PROJECT GITIGNORE
# ==============================================================================
# This file specifies intentionally untracked files that Git should ignore.
# For more information, see: https://git-scm.com/docs/gitignore

# --- Dependencies ---
# Third-party packages installed via package managers (npm/yarn/pnpm).
node_modules/

# --- Build & Output ---
# Compiled files and build artifacts for web and general scripts.
dist/
dist-ssr/
build/
out/
*.local

# --- Environment & Secrets ---
# Configuration files containing sensitive information or local overrides.
.env
.env.*
!.env.example

# --- Logs ---
# Error logs and debug files generated during runtime or installation.
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor & IDE ---
# Settings and temporary files from IDEs like IntelliJ/Android Studio and VS Code.
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# --- OS Specific ---
# System files generated by macOS and Windows.
.DS_Store
Thumbs.db
Desktop.ini

# --- Test & Coverage ---
# Results from test runners and code coverage reports.
coverage/
*.lcov
.nyc_output/

# --- TypeScript & Caches ---
# Cache files to speed up compilation and linting.
*.tsbuildinfo
.cache/
.temp/
.tmp/
.eslintcache

# --- Vite ---
# Temporary files generated by the Vite build tool.
vite.config.ts.timestamp-*

# --- Android & Local Tooling ---
# Android-specific build artifacts and local configuration files.
.gradle/
.kotlin/
local.properties
.cxx/
.externalNativeBuild/
/captures/
debug.keystore
